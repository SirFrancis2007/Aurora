<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/css/styles_shared.css" asp-append-version="true" />
    <title>@ViewData["Title"] Aurora</title>
    <link rel="icon" href="~/icon/Isotipo.ico" type="image/x-icon">
    <script type="importmap"></script>
</head>
<body>
    <header>
        <figure>
            <img src="~/icon/Logotipo.png" alt="Logotipo">
        </figure>
        <nav>
            <ul>
                <a asp-controller="Home" asp-action="Index"><h3>Aurora</h3></a>
                <a asp-controller="Home" asp-action="About"><h3>About Aurora</h3></a>
                <a asp-controller="Home" asp-action="FAQ"><h3>FAQ</h3></a>
                <a asp-controller="Administrador" asp-action="Index" class="btn-login-admin"><h3>Administradores</h3></a>
                <a asp-controller="Conductor" asp-action="IndexConductor" class="btn-login-admin"><h3>Conductores</h3></a>
            </ul>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer>
        <h6>Aurora ® 2025</h6>
        <h6>Built with love and dedication ─ Graduates 2025</h6>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

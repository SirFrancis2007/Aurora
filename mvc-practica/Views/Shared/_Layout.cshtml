<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/css/styles_shared.css" asp-append-version="true" />
    <title>@ViewData["Title"] Aurora</title>
    <link rel="icon" href="~/icon/Isotipo.ico" type="image/x-icon">
    <script type="importmap"></script>
    
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav>
            <ul>
                <button>Administradores</button>
                <figure>
                    <img src="" alt=""> <!-- Aca va el isotipo-->
                </figure>
                <button>conductores</button>
            </ul>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer>
        <h6>Aurora ® 2025</h6>
        <h6>Desarrollado con amor y dedicacion - Egresados 2025</h6>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] Aurora</title>
    <script type="importmap"></script>
</head>
<body>
    <header>
        <figure>
            <img src="" alt="Logotipo">
        </figure>
        <nav>
            <ul>
                <a asp-controller="Home" asp-action="Index"><h3>Aurora</h3></a>
                <a asp-controller="Home" asp-action="About"><h3>AboutAurora</h3></a>
                <a asp-controller="Home" asp-action="Contact"><h3>Contact</h3></a>
                <a asp-controller="Home" asp-action="FAQ"><h3>FAQ</h3></a>
                <a asp-controller="Account" asp-action="Login" class="btn-login-admin"><h3>↪</h3></a>
            </ul>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer>
        <h6>Aurora ® 2025</h6>
        <h6>Built with love and dedication ─ Graduates 2025</h6>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

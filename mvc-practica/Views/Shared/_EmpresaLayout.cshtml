<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/css/_sidebar.css" asp-append-version="true" />
    <title>@ViewData["Title"] Aurora</title>
    <link rel="icon" href="~/icon/Isotipo.ico" type="image/x-icon">
    <script type="importmap"></script>

    @RenderSection("Styles", required: false)
</head>
<body>
    <section class="sidebar">
        <div class="container-sidebar">
            <div class="links">
                <ul>
                    <li>
                        <a asp-controller="Empresa" asp-action="EmpresaAdministrador">
                            <img src="~/images/AdminIcon.png" alt="Administradores">
                            <i class="fas fa-shopping-cart"></i>
                            <span>Administrador</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Empresa" asp-action="VehiculoEmpresa">
                            <img src="~/images/VehiculoIcon.png" alt="">
                            <i class="fas fa-history"></i>
                            <span>Vehiculo</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Empresa" asp-action="HistorialPedido">
                            <img src="~/images/PedidoIcon.png" alt="">
                            <i class="fas fa-history"></i>
                            <span>Historial de Pedidos</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Empresa" asp-action="ConductorEmpresa">
                            <img src="~/images/ConductorIcon.png" alt="">
                            <i class="fas fa-history"></i>
                            <span>Conductores</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Empresa" asp-action="indexEmpresa">
                            <img src="~/images/PedidoIcon.png" alt="">
                            <i class="fas fa-history"></i>
                            <span>Pedidos Recibidos</span>
                        </a>
                    </li>
                    <li>
                        <form asp-controller="Home" asp-action="Logout" method="post" style="display:inline;">
                            <button type="submit" class="btn-logout">
                                <img src="~/images/LogOut.png" alt="">
                                <i class="fas fa-sign-out-alt"></i>
                                <span>LogOut</span>
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </section>

    <div class="main-container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

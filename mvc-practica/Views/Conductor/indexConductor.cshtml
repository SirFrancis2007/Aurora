@using Aurora.Core.Models
@model IEnumerable<PedidoRutaDTO>

@{
    ViewData["Title"] = "Conductor";
    Layout = "_ConductorLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/_table.css" />
    <link rel="stylesheet" href="~/css/_button.css" />
}

<div class="main-content">
    <div class="container">
        <h1>Listado de pedidos asignados a su vehiculo:</h1>

        <div class="actions" style="display:flex; flex-direction: row; gap: 20px; margin-bottom: 20px;">
            <form asp-action="IniciarViaje" method="post">
                <button type="submit" id="btn-conductor" class="btn btn-primary">Iniciar viaje</button>
            </form>
            <form asp-controller="Home" asp-action="Logout" method="post" style="display:inline;">
                <button id="btn-conductor" type="submit" class="btn-logout">
                    <span>Cerrar sesion</span>
                </button>
            </form>
        </div>

        <div class="table-container">
            <table class="Content-table">
                <thead class="table-header">
                    <tr>
                        <th>Codigo</th>
                        <th>Nombre del Paquete</th>
                        <th>Fecha Despacho</th>
                        <th>Lugar de Origen</th>
                        <th>Lugar de Destino</th>
                        <th>Estado Actual</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody id="tabla-pedidos">
                    @foreach (var pedido in Model.Where(p => p.Estado != "Entregado"))                    
                    {
                        <tr data-id="@pedido.IdPedido" data-estado="@pedido.Estado">
                            <td data-label="Código">@pedido.IdPedido</td>
                            <td data-label="Nombre Pedido">@pedido.NombrePedido</td>
                            <td data-label="Fecha de Despacho">@pedido.FechaDespacho.ToString("dd/MM/yyyy")</td>
                            <td data-label="Origen">@pedido.Origen</td>
                            <td data-label="Destino">@pedido.Destino</td>
                            <td data-label="Estado" class="estado">@pedido.Estado</td>
                            <td>
                                @if (pedido.Estado == "En viaje")
                                {
                                    <button id="btn-conductor" class="btn-entregar btn btn-warning">Entregar</button>
                                }
                                else if (pedido.Estado == "Entregado")
                                {
                                    <span class="badge bg-success">Entregado</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Desconocido</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const botones = document.querySelectorAll(".btn-entregar");

            botones.forEach(btn => {
                btn.addEventListener("click", async (e) => {
                    e.preventDefault();

                    const fila = e.target.closest("tr");
                    const idPedido = fila.getAttribute("data-id");

                    const response = await fetch(`/Conductor/MarcarEntregado/${idPedido}`, { method: "POST" });

                    if (response.ok) {
                        e.target.outerHTML = `<span class='badge bg-success'>Entregado</span>`;
                        fila.querySelector(".estado").innerText = "Entregado";
                    } else {
                        alert("Error al marcar el pedido como entregado");
                    }
                });
            });
        });
    </script>
}

@{
    ViewData["Title"] = "Empresa";
    Layout = "_EmpresaLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/_component.css" />
}

<div class="main-content">
    <div class="text-empresa">
        <h2>Welcome #nombre de la empresa</h2>
    </div>

    <div class="menu">
        <a asp-controller="Empresa" asp-action="AgregarAdministrador" class="btn btn-primary">Agregar Administrador</a>
    </div>

    <div class="container">
        <h1>Gestión de Administradores</h1>
        <div class="table-container">
            <table class="Content-table">
                <thead class="table-header">
                    <tr>
                        <th>Nombre del Administrador</th>
                    </tr>
                </thead>
                <!-- Por cada administrtador cargado se le agrega dos botones, actualizar y eliminar-->
            </table>
        </div>
    </div>
</div>
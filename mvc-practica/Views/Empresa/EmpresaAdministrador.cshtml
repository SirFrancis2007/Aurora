@using Aurora.Core
@model IEnumerable<Administrador>

@{
    ViewData["Title"] = "Empresa";
    Layout = "_EmpresaLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/_sidebar.css" />
    <link rel="stylesheet" href="~/css/_table.css" />
    <link rel="stylesheet" href="~/css/_button.css" />
}

<div class="main-content">
    <div class="menu">
        <a asp-controller="Empresa" asp-action="AgregarAdministrador" class="btn btn-primary">Agregar Administrador</a>
    </div>

    <div class="container">
        <h1>Gestión de Administradores</h1>
        <div class="table-container">
            <table class="Content-table">
                <thead class="table-header">
                    <tr>
                        <th>Nombre del Administrador</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center">No hay Administradores Asociados.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var admins in Model)
                            {
                                <tr>
                                    <td data-label="Nombre del Administrador">@admins.Nombre</td>
                                    <td>
                                        <form asp-action="EliminarAdministrador"
                                            asp-controller="Empresa"
                                            asp-route-idAdministrador="@admins.IdAdministrador"
                                            method="post"
                                            onsubmit="return confirm('¿Estás seguro de despedir a @admins.Nombre?');">
                                            <button type="submit" id="btn-admins" class="btn btn-danger">Eliminar</button>
                                        </form>
                                    </td>
                                </tr>
                            }                 
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
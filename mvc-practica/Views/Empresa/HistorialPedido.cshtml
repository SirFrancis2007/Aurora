@using Aurora.Core
@model IEnumerable<HistorialPedido>
@{
    ViewData["Title"] = "Empresa";
    Layout = "_EmpresaLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/_component.css" />
}

<div class="main-content">
    <div class="container">
        <h1>Historial de Pedidos</h1>
        <div class="table-container">
            <table class="Content-table">
                <thead class="table-header">
                    <tr>
                        <th>idHistorial</th>
                        <th>idPedido</th>
                        <th>Estado Anterior</th>
                        <th>Estado Actual</th>
                        <th>Fecha Registro</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var historial in Model)
                    {
                        <tr>
                            <td>@historial.IdHistorial</td>
                            <td>@historial.XidPedido</td>
                            <td>@historial.EstadoAnterior</td>
                            <td>@historial.EstadoActual</td>
                            <td>@historial.FechaCambio</td>
                        </tr>
                    }
            </table>
        </div>
    </div>
</div>

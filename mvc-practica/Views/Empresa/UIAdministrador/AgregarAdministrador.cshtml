@using Aurora.Core
@model Administrador

@{
    ViewData["Title"] = "Empresa";
    Layout = "_EmpresaLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/_sidebar.css" />
    <link rel="stylesheet" href="~/css/_form.css" />
}

<div class="main-content">
    <div class="form-inscripcion">
        <div class="formulario">
            <h2>Agregar Nuevo Administrador</h2>

            <form method="post" asp-action="AltaAdministrador" asp-controller="Empresa">
                <div class="form-group">
                    <label asp-for="Nombre">Nombre de Usuario del Administrador:</label>
                    <input type="text" asp-for="Nombre" required />

                    <label asp-for="Password">Contraseña del Administrador:</label>
                    <input type="password" asp-for="Password" required />
                </div>
                <button type="submit" class="btn-submit">Agregar Administrador</button>
            </form>
        </div>

        <div class="inscripciones">
            <h3>Recuerda</h3>
            <p>
                La seguridad de tu empresa es fundamental. Asegúrate de asignar contraseñas seguras y mantener la confidencialidad de las credenciales de los administradores.
            </p>
            <p>
                Asegurate de posisionar bien los datos ingresados para evitar errores de autenticación. <br> ¡Esta accion no podra ser modificada posteriormente!
            </p>
        </div>
    </div>
</div>

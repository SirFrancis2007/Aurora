@using Aurora.Core
@model Administrador

@{
    ViewData["Title"] = "Empresa";
    Layout = "_EmpresaLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/_form.css" />
}

<!-- Formulario para agregar un nuevo administrador -->
<div class="main-content">
    <div class="text-empresa">
        <h2>Agregar Nuevo Administrador</h2>
    </div>

    <div class="container">
        <form method="post" asp-action="AltaAdministrador" asp-controller="Empresa">
            <div class="form-group">
                <label asp-for="Nombre">Nombre del Administrador:</label>
                <input type="text" asp-for="Nombre" required />

                <label asp-for="Password">Contraseña del Administrador:</label>
                <input type="text" type="password" asp-for="Password" required />
            </div>
            <button type="submit" class="btn-submit">Agregar Administrador</button>
        </form>
    </div>
</div>
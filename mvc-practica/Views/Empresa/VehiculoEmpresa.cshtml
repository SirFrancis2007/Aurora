@using Aurora.Core
@model IEnumerable<Vehiculo>

@{
    ViewData["Title"] = "Empresa";
    Layout = "_EmpresaLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/_sidebar.css" />
    <link rel="stylesheet" href="~/css/_table.css" />
}

<div class="main-content">
    <div class="menu">
        <a asp-action="AgregarVehiculo" asp-controller="Empresa">Agregar Vehiculo</a>
        <a asp-action="AsignarVehiculoAConductor" asp-controller="Empresa">Asignar Vehiculo</a>
    </div>

    <div class="container">
        <h1>Gestión de Flota</h1>
        <div class="table-container">
            <table class="Content-table">
                <thead class="table-header">
                    <tr>
                        <th>id</th>
                        <th>Tipo</th>
                        <th>Matricula</th>
                        <th>Capacidad Maxima</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center">No hay Vehiculos.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var flota in Model)
                        {
                            <tr>
                                <td>@flota.IdVehiculo</td>
                                <td>@flota.Tipo</td>
                                <td>@flota.Matricula</td>
                                <td>@(flota.CapacidadMax + "Kg")</td>
                                <td>@(flota.Estado ? "Disponible" : "En viaje")</td>
                            </tr>
                        }
                    }
            </tbody>
            </table>
        </div>
    </div>
</div>

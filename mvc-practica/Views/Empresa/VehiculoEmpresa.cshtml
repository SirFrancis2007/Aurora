@model IEnumerable<Aurora.Core.PedidoEmpresaDTO>
@{
    ViewData["Title"] = "Empresa";
    Layout = "_EmpresaLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/VehiculoEmpresa.css" />
}

<div class="main-content">
    <div class="text-empresa">
        <h2>Welcome #nombre de la empresa</h2>
    </div>

    <div class="menu">
        <a asp-action="AgregarVehiculo" asp-controller="Empresa">Agregar Vehiculo</a>
        <a asp-action="AsignarVehiculoAConductor" asp-controller="Empresa">Asignar Vehiculo</a>
    </div>

    <div class="container">
        <h1>Gestión de Flota</h1>
        <div class="table-container">
            <table class="Content-table">
                <thead class="table-header">
                    <tr>
                        <th>id</th>
                        <th>Tipo</th>
                        <th>Matricula</th>
                        <th>Capacidad Maxima</th>
                        <th>Estado</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@model IEnumerable<Aurora.Core.PedidoEmpresaDTO>
@{
    ViewData["Title"] = "Empresa";
    Layout = "_EmpresaLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/HistorialPedido" />
}

<div class="main-content">
    <div class="text-empresa">
        <h2>Welcome #nombre de la empresa</h2>
    </div>

    <div class="container">
        <h1>Historial de Pedidos</h1>
        <div class="table-container">
            <table class="Content-table">
                <thead class="table-header">
                    <tr>
                        <th>idHistorial</th>
                        <th>idPedido</th>
                        <th>Estado Anterior</th>
                        <th>Estado Actual</th>
                        <th>Fecha Registro</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

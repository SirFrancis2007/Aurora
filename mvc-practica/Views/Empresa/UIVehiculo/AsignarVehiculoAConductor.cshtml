@using Aurora.Core.Models
@model IEnumerable<VehiculoConductorDTO>
@{
    ViewData["Title"] = "Empresa";
    Layout = "_EmpresaLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/_select.css" /> 
}

<div class="main-content">
    <div class="text-empresa">
        <h2>Asignar Vehiculo a Conductor</h2>
    </div>

    <div class="container-tbl">
        <div class="table-container">
            <table class="Content-table">
                <thead class="table-header">
                    <tr>
                        <th>Conductor</th>
                        <th>Licencia</th>
                        <th>Vehículo</th>
                        <th>Matrícula</th>
                        <th>Fecha Asignado</th>
                        <th>Disponibilidad</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.NombreConductor</td>
                            <td>@item.Licencia</td>
                            <td>@(item.Tipo ?? "Sin asignar")</td>
                            <td>@(item.Matricula ?? "-")</td>
                            <td>@(item.FechaAsignado?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td>@(item.Disponibilidad == 1 ? "Disponible" : "Ocupado")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="main-content">
    <div class="container-form">
        <form method="post" asp-action="AltaAsignacionVehiculoConductor" asp-controller="Empresa">
            <div class="form-group">
                <label for="vehiculo">Vehiculo:</label>
                <select id="vehiculo" name="idVehiculo" class="form-control">
                    <option value="">-- Selecciona un vehículo --</option>
                    @foreach (var v in Model.Where(x => x.EstadoVehiculo == 1))
                    {
                        <option value="@v.IdVehiculo" 
                                data-tipo="@v.Tipo" 
                                data-matricula="@v.Matricula" 
                                data-capacidad="@v.CapacidadMax">
                            @v.Matricula (@v.Tipo)
                        </option>
                    }
                </select>

                <div id="vehiculo-info" class="info-box"></div>

                <label for="Conductor">Conductor:</label>
                <select id="conductor" name="idConductor" class="form-control">
                    <option value="">-- Selecciona un conductor --</option>
                    @foreach (var c in Model.Where(c => c.Disponibilidad == 1))
                    {
                        <option value="@c.IdConductor" 
                                data-nombre="@c.NombreConductor" 
                                data-licencia="@c.Licencia">
                            @c.NombreConductor
                        </option>
                    }
                </select>

                <div id="conductor-info" class="info-box"></div>
            </div>

            <button type="submit" class="btn-submit">Asignar Vehiculo a Conductor</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("vehiculo").addEventListener("change", function () {
            var selected = this.options[this.selectedIndex];
            var infoBox = document.getElementById("vehiculo-info");

            if (selected.value) {
                infoBox.innerHTML = `
                    <strong>Tipo:</strong> ${selected.dataset.tipo} <br/>
                    <strong>Matrícula:</strong> ${selected.dataset.matricula} <br/>
                    <strong>Capacidad:</strong> ${selected.dataset.capacidad}
                `;
            } else {
                infoBox.innerHTML = "";
            }
        });

        document.getElementById("conductor").addEventListener("change", function () {
            var selected = this.options[this.selectedIndex];
            var infoBox = document.getElementById("conductor-info");

            if (selected.value) {
                infoBox.innerHTML = `
                    <strong>Nombre:</strong> ${selected.dataset.nombre} <br/>
                    <strong>Licencia:</strong> ${selected.dataset.licencia}
                `;
            } else {
                infoBox.innerHTML = "";
            }
        });
    </script>
}

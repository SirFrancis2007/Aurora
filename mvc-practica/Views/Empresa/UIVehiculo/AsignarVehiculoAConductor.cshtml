@using Aurora.Core.Models
@model AsignacionVehiculoViewModel

@{
    ViewData["Title"] = "Empresa";
    Layout = "_EmpresaLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/_sidebar.css" />
    <link rel="stylesheet" href="~/css/_table.css" />
    <link rel="stylesheet" href="~/css/_select.css" />
    <link rel="stylesheet" href="~/css/_button.css" />
}


<div class="main-content">
    <div class="text-empresa">
        <h2>Asignar vehículo a conductor</h2>
    </div>

    <div class="container-tbl">
        <div class="table-container">
            <table class="Content-table">
                <thead class="table-header">
                    <tr>
                        <th>Nombre del conductor</th>
                        <th>Licencia</th>
                        <th>Tipo de vehículo</th>
                        <th>Matrícula</th>
                        <th>Fecha Asignado</th>
                        <th>Disponibilidad</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ConductoresAsignados)
                    {
                        <tr>
                            <td>@item.NombreConductor</td>
                            <td>@item.Licencia</td>
                            <td>@item.Tipo</td>
                            <td>@item.Matricula</td>
                            <td>@item.FechaAsignado?.ToString("dd/MM/yyyy")</td>
                            <td>@(item.Disponibilidad == 1 ? "Disponible" : "En viaje")</td>
                            <td>
                                <form asp-controller="Empresa" asp-action="DesvincularVehiculoConductor" method="post" style="display:inline;">
                                    <input type="hidden" name="idConductor" value="@item.IdConductor" />
                                    <input type="hidden" name="idVehiculo" value="@item.IdVehiculo" />
                                    <button type="submit" id="btn-vehcon" class="btn-desvincular">
                                        Desvincular vehículo de conductor
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="main-content">
    <div class="container-form">
        <form method="post" asp-action="AltaAsignacionVehiculoConductor" asp-controller="Empresa">
            <div class="form-group">
                <label for="vehiculo">Vehiculo:</label>
                <select id="vehiculo" name="idVehiculo" class="form-control">
                    <option value="">-- Seleccione un vehículo --</option>
                    @foreach (var v in Model.VehiculosNoAsignados)
                    {
                        <option value="@v.IdVehiculo">@v.Matricula (@v.Tipo)</option>
                    }
                </select>

                <div style="margin-top: 10px; margin-button: 20px" id="vehiculo-info" class="info-box"></div>

                <label for="Conductor">Conductor:</label>
                <select id="conductor" name="idConductor" class="form-control" >
                    <option value="">-- Seleccione un conductor --</option>
                    @foreach (var c in Model.ConductoresNoAsignados)
                    {
                        <option value="@c.IdConductor">@c.NombreConductor</option>
                    }
                </select>
                <div id="conductor-info" class="info-box"></div>
            </div>

            <button style="margin-top: 20px" type="submit" id="btn-conductor" class="btn-submit">Asignar Vehiculo a Conductor</button>
        </form>
    </div>
</div>
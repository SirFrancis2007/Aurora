@using Aurora.Core
@model Vehiculo

@{
    ViewData["Title"] = "Empresa";
    Layout = "_EmpresaLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/_form.css" />
}

<!-- Formulario para agregar un nuevo VEHICULO -->
<div class="main-content">
    <div class="text-empresa">
        <h2>Agregar Nuevo Vehiculo</h2>
    </div>

    <div class="container">
        <form method="post" asp-action="AltaVehiculo" asp-controller="Empresa">
            <div class="form-group">
                <label asp-for="Tipo" for="nombre">Tipo:</label>
                <input asp-for="Tipo" type="text" required />

                <label asp-for="Matricula" for="nombre">Matricula:</label>
                <input type="text" asp-for="Matricula" required />

                <label asp-for="CapacidadMax" for="nombre">Capacidad Maxima:</label>
                <input type="text" asp-for="CapacidadMax" required />

                <!-- El estado se define como true, osea disponible-->
                <button type="submit" class="btn-submit">Agregar Vehiculo</button>
            </div>
        </form>
    </div>
</div>
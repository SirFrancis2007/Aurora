@using Aurora.Core
@model Vehiculo

@{
    ViewData["Title"] = "Empresa";
    Layout = "_EmpresaLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/_sidebar.css" />
    <link rel="stylesheet" href="~/css/_form.css" />
}

<div class="main-content">
    <div class="form-inscripcion">
        <div class="formulario">
            <h2>Agregar Vehiculo a <strong>Aurora</strong></h2>

            <form method="post" asp-action="AltaVehiculo" asp-controller="Empresa">
                <div class="form-group">
                    <label asp-for="Tipo" for="nombre">Tipo de vehiculo:</label>
                    <input asp-for="Tipo" type="text" required />

                    <label asp-for="Matricula" for="nombre">Matricula:</label>
                    <input type="text" asp-for="Matricula" required />

                    <label asp-for="CapacidadMax" for="nombre">Capacidad Maxima | KILOGRAMOS (KG)</label>
                    <input type="text" asp-for="CapacidadMax" required/>
                </div>
                <button type="submit" class="btn-submit">Registrar el vehiculo</button>
            </form>
        </div>

        <div class="inscripciones">
            <h3>Recuerda</h3>
            <p>
                Los datos ingresados no podran ser modificados posteriormente.
            </p>
            <p>
                Asegurate de ser claro y descriptivo con los datos del vehiculo
            </p>
            <p>
                LA CAPACIDAD SE MIDE EN LA UNIDAD KILOGRAMOS (KG).
            </p>
        </div>
    </div>
</div>
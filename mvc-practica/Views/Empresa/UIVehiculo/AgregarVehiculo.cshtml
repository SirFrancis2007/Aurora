@{
    ViewData["Title"] = "Empresa";
    Layout = "_EmpresaLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/_form.css" />
}

<!-- Formulario para agregar un nuevo VEHICULO -->
<div class="main-content">
    <div class="text-empresa">
        <h2>Agregar Nuevo Vehiculo</h2>
    </div>

    <div class="container">
        <form method="post" action="">
            <div class="form-group">
                <label for="nombre">Tipo:</label>
                <input type="text" name="Tipo" required />

                <label for="nombre">Matricula:</label>
                <input type="text" name="Matricula" required />

                <label for="nombre">Capacidad Maxima:</label>
                <input type="text" name="Capacidad Maxima" required />

                <!-- El estado se define como true, osea disponible-->
            </div>
        </form>
        <button type="submit" class="btn-submit">Agregar Vehiculo</button>
    </div>
</div>
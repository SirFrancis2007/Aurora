@using Aurora.Core
@model Conductor

@{
    ViewData["Title"] = "Empresa";
    Layout = "_EmpresaLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/_sidebar.css" />
    <link rel="stylesheet" href="~/css/_form.css" />
}

<div class="main-content">
    <div class="form-inscripcion">
        <div class="formulario">
            <h2>Agregar Nuevo Conductor</h2>

            <form method="post" asp-action="AltaAdministrador" asp-controller="Empresa">
                <div class="form-group">
                    <label asp-for="Name">Nombre de usuario del Conductor:</label>
                    <input type="text" asp-for="Name" required />

                    <label asp-for="Licencia">Licencia del Conductor:</label>
                    <input type="text" asp-for="Licencia" required />
                </div>
                <button type="submit" class="btn-submit">Agregar Conductor</button>
            </form>
        </div>

        <div class="inscripciones">
            <h3>Recuerda</h3>
            <p>
                La seguridad de tu empresa es fundamental. Asegúrate de asignar contraseñas seguras y mantener la confidencialidad de las credenciales de los Conductores.
            </p>
            <p>
                Asegurate de posisionar bien los datos ingresados para evitar errores de autenticación. <br> ¡Esta accion podra modificada posteriormente!
            </p>
        </div>
    </div>
</div>
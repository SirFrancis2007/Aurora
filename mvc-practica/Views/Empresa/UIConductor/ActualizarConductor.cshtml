@using Aurora.Core
@model Conductor

@{
    ViewData["Title"] = "Empresa";
    Layout = "_EmpresaLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/_sidebar.css" />
    <link rel="stylesheet" href="~/css/_form.css" />
}

<div class="main-content">
    <div class="form-inscripcion">
        <div class="formulario">
            <h2>Actualizar datos del Conductor</h2>

            <form method="post" asp-action="UpdateConductor" asp-controller="Empresa">
                <div class="form-group">
                    <label asp-for="Name">Nombre de usuario del Conductor:</label>
                    <input type="text" asp-for="Name" required />

                    <label asp-for="Licencia">Licencia del Conductor:</label>
                    <input type="password" asp-for="Licencia" required />
                </div>
                <button type="submit" class="btn-submit">Actualizar Conductor</button>
            </form>
        </div>

        <div class="inscripciones">
            <h3>Recuerda</h3>
            <p>
                Tene en cuenta que la modificacion se vera reflejada en el sistema de gestion de conductores.
            </p>
            <p>
                Asegurate de posisionar bien los datos ingresados para evitar errores de autenticación. <br> ¡Esta accion podra modificada posteriormente!
            </p>
            <p>
                A partir de ahora, los conductores podran iniciar sesión con solo las nuevas credenciales.
            </p>
        </div>
    </div>
</div>
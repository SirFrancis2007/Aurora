@model IEnumerable<Aurora.Core.PedidoEmpresaDTO>
@{
    ViewData["Title"] = "Empresa";
    Layout = "_EmpresaLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/indexEmpresa.css" />
}

<div class="main-content">
    <div class="text-empresa">
        <h2>Welcome #nombre de la empresa</h2>
    </div>

    <div class="container">
        <h1>Gestión de Pedidos</h1>
        <div class="table-container">
            <table class="Content-table">
                <thead class="table-header">
                    <tr>
                        <th>Empresa Origen</th>
                        <th>Empresa Destino</th>
                        <th>Pedido</th>
                        <th>Volumen</th>
                        <th>Peso</th>
                        <th>Estado del pedido</th>
                        <th>Fecha Despacho</th>
                    </tr>
                </thead>
                <tbody class="table-body">
                    @foreach (var _pedido in Model)
                    {
                        <tr>
                            <td>@_pedido.NombreEmpresa</td>
                            <td>@_pedido.NombreEmpresa</td>
                            <td>@_pedido.NombrePedido</td>
                            <td>@_pedido.Volumen</td>
                            <td>@_pedido.Peso</td>
                            <td>@_pedido.Estado</td>
                            <td>@_pedido.FechaDespacho.ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

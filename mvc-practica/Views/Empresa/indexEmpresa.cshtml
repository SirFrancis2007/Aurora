@model IEnumerable<Aurora.Core.PedidoEmpresaDTO>

@{
    ViewData["Title"] = "Pedidos de la Empresa";
    Layout = "_EmpresaLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/_sidebar.css" />
    <link rel="stylesheet" href="~/css/_table.css" />
}

<div class="main-content">
    <div class="container">
        <h1>Pedidos que recibe la sucursal</h1>
        <div class="table-container">
            <table class="Content-table">
                <thead class="table-header">
                    <tr>
                        <th>Sucursal de Destino</th>
                        <th>Pedido</th>
                        <th>Volumen (m3)</th>
                        <th>Peso (Kg)</th>
                        <th>Estado actual</th>
                        <th>Fecha de despacho</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center">No hay pedidos registrados.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var pedido in Model)
                        {
                            <tr>
                                <td data-label="Nombre Sucursal">@pedido.NombreEmpresa</td>
                                <td data-label="Nombre">@pedido.NombrePedido</td>
                                <td data-label="Volumen">@(pedido.Volumen + "m3")</td>
                                <td data-label="Peso">@(pedido.Peso + "Kg")</td>
                                <td data-label="Estado">
                                    @{
                                        var estadoClass = pedido.Estado switch
                                        {
                                            "Despachado" => "estado-despachado",
                                            "En viaje" => "estado-en-viaje",
                                            "Entregado" => "estado-entregado",
                                            "Recibido" => "estado-recibido",
                                            _ => ""
                                        };
                                    }
                                    <span class="estado-badge @estadoClass">@pedido.Estado</span>
                                </td>
                                <td data-label="Fecha depacho">@pedido.FechaDespacho.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

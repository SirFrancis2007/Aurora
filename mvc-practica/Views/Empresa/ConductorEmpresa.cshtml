@using Aurora.Core
@model IEnumerable<Conductor>

@{
    ViewData["Title"] = "Empresa";
    Layout = "_EmpresaLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/_sidebar.css" />
    <link rel="stylesheet" href="~/css/_table.css" />
    <link rel="stylesheet" href="~/css/_button.css" />
}

<div class="main-content">
    <div class="menu">
        <a asp-action="NuevoConductor" asp-controller="Empresa">Agregar Conductor</a>
    </div>

    <div class="container">
        <h1>Gestión de Conductores</h1>
        <div class="table-container">
            <table class="Content-table">
                <thead class="table-header">
                    <tr>
                        <th>Nombre</th>
                        <th>Licencia</th>
                        <th>Disponibilidad</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var conductor in Model)
                    {
                        <tr>
                            <td>@conductor.Name</td>
                            <td>@conductor.Licencia</td>
                            <td>@(conductor.Disponibilidad ? "Disponible" : "En viaje")</td>
                            <td>
                                <td>
                                    <a asp-action="ActualizarConductor"
                                    asp-route-id="@conductor.IdConductor"
                                    class="btn btn-update">
                                        Modificar
                                    </a>
                                </td>
                            </td>
                        </tr>
                    }
            </table>
        </div>
    </div>
</div>

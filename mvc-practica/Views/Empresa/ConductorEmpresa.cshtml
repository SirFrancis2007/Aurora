@model IEnumerable<Aurora.Core.PedidoEmpresaDTO>
@{
    ViewData["Title"] = "Empresa";
    Layout = "_EmpresaLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/ConductorEmpresa.css" />
}

<div class="main-content">
    <div class="text-empresa">
        <h2>Welcome #nombre de la empresa</h2>
    </div>

    <div class="menu">
        <a asp-action="NuevoConductor" asp-controller="Empresa">Agregar Conductor</a>
    </div>

    <div class="container">
        <h1>Gestión de Conductores</h1>
        <div class="table-container">
            <table class="Content-table">
                <thead class="table-header">
                    <tr>
                        <th>Nombre</th>
                        <th>Licencia</th>
                        <th>Disponibilidad</th>
                    </tr>
                </thead>
                
            </table>
        </div>
    </div>
</div>

@using Aurora.Core
@model mvc_practica.Models.AutenticacionDTO

@{
    ViewData["Title"] = "Home Page";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/index.css"/>
}

<section class="main-container">
    <div class="title">
        <h1>Aurora</h1>
        <h4>Sistema de logistica</h4>
    </div>
    <div class="content">
        <span>Plataforma para gestionar mercancia entre entidades, vehiculos, administradores, conductores. Foncalizado en la eficiencia, integridad y la simplicidad</span>
        <button id="btn-header" class="btn-registro">Registrer</button>
        <button id="btn-header" class="btn-login">Login in</button>
    </div>
</section>

<!--Aca se encuentra la estrucutra de los modales de inicio sesion y registro-->
<!-- Modal LOGIN Universal (se podran loguear todos los actores por igual) -->
<section id="modal-login-empresa" class="modal">
    <div class="modal__container">
        <div class="modal__header">
            <h2 class="modal__title">Login Empresa</h2>
            <a href="#" class="modal__close">×</a>
        </div>
        <form asp-action="LoginUniversal" asp-controller="Home" method="post">
            <div class="modal__field">
                <label asp-for="Usuario" class="modal__label">Nombre de Usuario</label>
                <input asp-for="Usuario" type="text" class="modal__input" placeholder="Ingrese su nombre de usuario">

                <label asp-for="Contrasena" class="modal__label">Contraseña</label>
                <input asp-for="Contrasena" type="password" class="modal__input" placeholder="Ingrese su contraseña">

                <label for="rol">Seleccione su tipo de rol</label>
                <select name="Rol" required>
                    <option value="empresa">Empresa</option>
                    <option value="admin">Administrador</option>
                    <option value="conductor">Conductor</option>
                </select>
            </div>
            <button type="submit" class="modal__submit">Iniciar Sesión</button>
        </form>
    </div>
</section>

<!-- Modal SIGNUP EMPRESA -->
<section id="modal-signup-empresa" class="modal">
    <div class="modal__container">
        <div class="modal__header">
            <h2 class="modal__title">Registro Empresa</h2>
            <a href="#" class="modal__close">×</a>
        </div>
        <form asp-action="Post_Empresa" asp-controller="Home" method="post" class="modal__form">
            <div class="modal__field">
                <label asp-for="Usuario" class="modal__label">Nombre de la Empresa</label>
                <input asp-for="Usuario" type="text" class="modal__input" placeholder="Ingresa el nombre de tu empresa">
                
                <label asp-for="Contrasena" class="modal__label">Contraseña</label>
                <input asp-for="Contrasena" type="password"  class="modal__input" placeholder="Ingrese la contraseña">
            </div>
            <button type="submit" class="modal__submit">Registrar Empresa</button>
        </form>
    </div>
</section>


<script src="~/JavaScript/modals.js"></script>

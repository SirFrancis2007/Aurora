@using Aurora.Core
@model mvc_practica.Models.IndexViewModel
@{
    ViewData["Title"] = "Home Page";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="">
    <link rel="shortcut icon" href="favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
    <title>Aurora</title>
</head>
<body>
    <section>
        <div class="main-text">
            <div class="text">
                <h1 id="t1">Logistic System</h1>
                <span id="span-text">Prepare your package! Control your business and track every package. Easy, Free, secure. Aurora offers a unique service for your business to thrive. Register and get started. Welcome!</span>
                <button id="btn-header" class="btn-registro">Registrer</button>
                <button id="btn-header" class="btn-login">Login in</button>
            </div>
            <img src="~/images/logistica2.jpg" alt="Logistica">
        </div>
    </section>

    <!--Aca se encuentra la estrucutra de los modales de inicio sesion y registro-->
    <!-- Modal LOGIN EMPRESA -->
    <section id="modal-login-empresa" class="modal">
        <div class="modal__container">
            <div class="modal__header">
                <h2 class="modal__title">Login Empresa</h2>
                <a href="#" class="modal__close">×</a>
            </div>
            <form asp-action="Login_Empresa" asp-controller="Home" method="post" class="modal__form">
                <div class="modal__field">
                    <label asp-for="Empresa.Nombre" class="modal__label">Nombre de la Empresa</label>
                    <input asp-for="Empresa.Nombre" type="text" class="modal__input" placeholder="Ingresa el nombre de tu empresa">
                </div>
                <button type="submit" class="modal__submit">Iniciar Sesión</button>
            </form>
        </div>
    </section>

    <!-- Modal SIGNUP EMPRESA -->
    <section id="modal-signup-empresa" class="modal">
        <div class="modal__container">
            <div class="modal__header">
                <h2 class="modal__title">Registro Empresa</h2>
                <a href="#" class="modal__close">×</a>
            </div>
            <form asp-action="Post_Empresa" asp-controller="Home" method="post" class="modal__form">
                <div class="modal__field">
                    <label asp-for="Empresa.Nombre" class="modal__label">Nombre de la Empresa</label>
                    <input asp-for="Empresa.Nombre" type="text" class="modal__input" placeholder="Ingresa el nombre de tu empresa">
                </div>
                <button type="submit" class="modal__submit">Registrar Empresa</button>
            </form>
        </div>
    </section>

    <!-- Modal LOGIN ADMIN -->
    <section id="modal-login-admin" class="modal">
        <div class="modal__container">
            <div class="modal__header">
                <h2 class="modal__title">Login Administrador</h2>
                <a href="#" class="modal__close">×</a>
            </div>
            <form asp-action="Login_Administrador" method="post" class="modal__form">
                <div class="modal__field">
                    <label asp-for="Administrador.Nombre" class="modal__label">Usuario</label>
                    <input asp-for="Administrador.Nombre" type="text" class="modal__input" placeholder="Ingresa tu usuario">
                </div>
                <div class="modal__field">
                    <label asp-for="Administrador.Password" class="modal__label">Contraseña</label>
                    <input asp-for="Administrador.Password" type="password" class="modal__input" placeholder="Ingresa tu contraseña">
                </div>
                <button type="submit" class="modal__submit">Iniciar Sesión</button>
            </form>
        </div>
    </section>
    <script src="~/JavaScript/modals.js"></script>
</body>
</html>
@using Aurora.Core
//Referenciar por el nombre del namespace
@model Aurora.Core.Empresa
@{
    ViewData["Title"] = "Home Page";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="">
    <link rel="shortcut icon" href="favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
    <title>Aurora</title>
</head>
<body>
    <section>
        <div class="main-text">
            <div class="text">
                <h1 id="t1">Logistic System</h1>
                <span id="span-text">Prepare your package! Control your business and track every package. Easy, Free, secure. Aurora offers a unique service for your business to thrive. Register and get started. Welcome!</span>
                <button id="btn-header" class="btn-registro">Registrer</button>
                <button id="btn-header" class="btn-login">Login in</button>
            </div>
            <img src="~/images/logistica2.jpg" alt="Logistica">
        </div>
    </section>

    <!--Aca se encuentra la estrucutra de los modales de inicio sesion y registro-->
    <!-- Modal LOGIN EMPRESA-->
    <section class="modal-login">
        <div class="modal container-login">
            <a href="#" class="Modal-close">Close</a>
            <form action="" method="post">
                <label asp-for="Nombre" for="name">Company</label>
                <input asp-for="Nombre" type="text" name="company" id="">

                <button class="btn-summit">Summit</button>
            </form>
        </div>
    </section>

    <!-- Modal SIGNUP EMPRESA-->
    <section class="modal-signup">
        <div class="modal container-signup">
            <a href="#" class="Modal-close">Close</a>
            <form action="" method="post">
                <label asp-for="Nombre" for="name">Company</label>
                <input asp-for="Nombre" type="text" name="company" id="">

                <button class="btn-summit">Summit</button>
            </form>
        </div>
    </section>


    <!-- Modal LOGIN Admin -->
    <section class="modal-admin">
        <div class="modal container-admin">
            <a href="#" class="Modal-close">Close</a>
            <form action="" method="post">
                <label for="name">Nombre</label>
                <input type="text" name="company" id="">

                <label for="Pass">Password</label>
                <input type="password" name="pass" id="">

                <button class="btn-summit"> Summit</button>
            </form>
        </div>
    </section>
    <script src="~/JavaScript/modals.js"></script>
</body>
</html>
@{
    ViewData["Title"] = "Home Page";
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/Contact.css" asp-append-version="true" />
    <title>Contact</title>
</head>
<body>
    <section class="form">
        <div class="container">
            <div class="form-section">
                <form id="contactForm">
                    <div class="input-group">
                        <label for="email">Email</label>
                        <input type="email" id="email" name="email" required>
                    </div>

                    <div class="input-group">
                        <label for="company">Empresa</label>
                        <input type="text" id="company" name="company" required>
                    </div>

                    <div class="input-group">
                        <label for="company">Asunto</label>
                        <input type="Asunto" id="xidAsunto" name="Asunto" required>
                    </div>

                    <div class="input-group">
                        <label for="problem">Describe tu problema</label>
                        <textarea id="problem" name="problem" placeholder="Cuéntanos en qué podemos ayudarte..." required></textarea>
                    </div>

                    <button type="submit" class="submit-btn">Enviar Mensaje</button>
                </form>
            </div>

            <div class="contact-info">
                <div class="floating-elements">
                    <div class="floating-circle"></div>
                    <div class="floating-circle"></div>
                    <div class="floating-circle"></div>
                </div>
                
                <h2 class="contact-title">Contacto</h2>
                
                <div class="contact-detail">
                    <div class="contact-label">Email</div>
                    <div class="contact-value">contacto@empresa.com</div>
                </div>
                
                <div class="contact-detail">
                    <div class="contact-label">Ubicación</div>
                    <div class="contact-value">Buenos Aires, Argentina</div>
                </div>
                
                <div class="contact-detail">
                    <div class="contact-label" id="aurora">Aurora</div>
                    <div class="contact-label" id="Autor">Francisco Agustin García 6°8°</div>
                </div>
            </div>
        </div>
    </section>
</body>
</html>
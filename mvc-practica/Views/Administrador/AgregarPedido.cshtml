@model PedidoViewModel;

@{
    ViewData["Title"] = "Administrador";
    Layout = "_AdminLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/_formPedido.css" />
}

<div class="main-content">
    <div class="text-empresa">
        <h2>Agregar Nuevo Pedido</h2>
    </div>

    <div class="container">
        <form asp-action="AgregarPedido" method="post">
                <div class="form-group">
                    <label>Título:</label>
                    <input asp-for="Titulo" type="text" required />

                    <label>Volumen (m³):</label>
                    <input asp-for="Volumen" type="text" required />

                    <label>Peso (kg):</label>
                    <input asp-for="Peso" type="text" required />

                    <label>Estado:</label>
                    <select asp-for="Estado">
                        <option value="Despachado">Despachado</option>
                    </select>

                    <label>Fecha Despacho:</label>
                    <input asp-for="FechaDespacho" type="date" required />

                    <label>Ruta:</label>
                    <select asp-for="IdRuta">
                        @foreach (var ruta in Model.Rutas)
                        {
                            <option value="@ruta.IdRuta">@ruta.Origen - @ruta.Destino</option>
                        }
                    </select>

                    <label>Empresa Destino:</label>
                    <select asp-for="IdEmpresaDestino">
                        @foreach (var empresa in Model.Empresas)
                        {
                            <option value="@empresa.IdEmpresa">@empresa.Nombre</option>
                        }
                    </select>

                    <label>Vehículo:</label>
                    <select asp-for="IdVehiculo">
                        @foreach (var v in Model.Vehiculos)
                        {
                            <option value="@v.IdVehiculo">
                                @v.Tipo :Tipo - @v.Matricula :Matricula - @v.CapacidadRestante kg)
                            </option>
                        }
                    </select>
                </div>
            <button type="submit" class="btn-submit">Despachar</button>
        </form>
    </div>
</div>
@model PedidoViewModel;

@{
    ViewData["Title"] = "Administrador";
    Layout = "_AdminLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/_sidebar.css" />
    <link rel="stylesheet" href="~/css/_form.css" />
    <link rel="stylesheet" href="~/css/_select.css" />
}

<div class="main-content">
    <div class="form-inscripcion">
        <div class="formulario">
            <h2>Despachar Pedido</h2>

            <form asp-action="AgregarPedido" method="post">
                <div class="form-group">
                    <label for="Titulo">Título:</label>
                    <input asp-for="Titulo" type="text" class="form-control" required />

                    <label for="Volumen">Volumen (m³):</label>
                    <input asp-for="Volumen" type="text" class="form-control" required />

                    <label for="Peso">Peso (kg):</label>
                    <input asp-for="Peso" type="text" class="form-control" required />

                    <label for="Estado">Estado:</label>
                    <select asp-for="Estado" class="form-control">
                        <option value="Despachado">Despachado</option>
                    </select>

                    <label for="FechaDespacho">Fecha Despacho:</label>
                    <input asp-for="FechaDespacho" type="date" class="form-control" required />

                    <label for="IdRuta">Ruta:</label>
                    <select asp-for="IdRuta" class="form-control">
                        @foreach (var ruta in Model.Rutas)
                        {
                            <option value="@ruta.IdRuta">@ruta.Origen - @ruta.Destino</option>
                        }
                    </select>

                    <label for="IdEmpresaDestino">Empresa Destino:</label>
                    <select asp-for="IdEmpresaDestino" class="form-control">
                        @foreach (var empresa in Model.Empresas)
                        {
                            <option value="@empresa.IdEmpresa">@empresa.Nombre</option>
                        }
                    </select>

                    <label for="IdVehiculo">Vehículo:</label>
                    <select asp-for="IdVehiculo" class="form-control">
                        @foreach (var v in Model.Vehiculos)
                        {
                            <option value="@v.IdVehiculo">
                                @v.Tipo (Tipo) - @v.Matricula (Matrícula) - @v.CapacidadMax kg
                            </option>
                        }
                    </select>
                </div>

                <button type="submit" class="btn-submit">Despachar Pedido</button>
            </form>
        </div>
    </div>
</div>

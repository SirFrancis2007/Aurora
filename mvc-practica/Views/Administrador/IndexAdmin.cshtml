@{
    ViewData["Title"] = "Administradores";
    Layout = "_AdminLayout";
}
<!-- Admin podra hacer 
    _ Hacer Pedidos
    _ Recibir pedidos
    _ Log Out
    _ Ver el Historial de los paquetes-->
@section Styles {
    <link rel="stylesheet" href="~/css/_Component.css" />
}

<div class="main-content">
    <div class="menu">
        <a asp-action="AgregarVehiculo" asp-controller="Empresa">Nuevo Pedido</a>
    </div>

    <div class="container">
        <h1>Bandeja de Entrada</h1>
        <div class="table-container">
            <table class="Content-table">
                <thead class="table-header">
                    <tr>
                        <th>id</th>
                        <th>Paquete</th>
                        <th>Volumen</th>
                        <th>Peso</th>
                        <th>Estado</th>
                        <th>Fecha Despacho</th>
                        <th>Origen</th>
                        <th>Destino</th>
                        <th>Matricula</th>
                        <th>Conductor</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

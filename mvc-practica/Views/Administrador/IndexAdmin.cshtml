<!-- Admin podra hacer 
    _ Hacer Pedidos
    _ Recibir pedidos
    _ Log Out
    _ Ver el Historial de los paquetes
    _ Tendra una bandeja de entrada donde tenga solos los pedidos que esten en el estado entregado y un boton donde tenga para actualizar el estaod de pedidos a RECIBIDOS-->

@using Aurora.Core.Models
@model IEnumerable<PedidoRutaDTO>

@{
    ViewData["Title"] = "Administradores";
    Layout = "_AdminLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/_sidebar.css" />
    <link rel="stylesheet" href="~/css/_table.css" />
}

<div class="main-content">
    <div class="menu">
        <a asp-action="AgregarPedido" asp-controller="Administrador">Realizar nuevo pedido</a>
    </div>
        <div class="container">
            <h1>Paquetes entrantes:</h1>
            <div class="table-container">
                <table class="Content-table">
                    <thead class="table-header">
                        <tr>
                            <th>Codigo</th>
                            <th>Nombre Pedido</th>
                            <th>Peso (KG)</th>
                            <th>Volumen (M3)</th>
                            <th>Estado actual</th>
                            <th>Fecha Despacho</th>
                            <th>Surcursal Origen</th>
                            <th>Surcursal Destino</th>
                            <th>Lugar de Origen</th>
                            <th>Lugar de Destino</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pedido in Model)
                        {
                            <tr>
                                <td>@pedido.IdPedido</td>
                                <td>@pedido.NombrePedido</td>
                                <td>@pedido.Peso</td>
                                <td>@pedido.Volumen</td>
                                <td>@pedido.Estado</td>
                                <td>@pedido.FechaDespacho.ToString("dd/MM/yyyy")</td>
                                <td>@pedido.EmpresaOrigen</td>
                                <td>@pedido.EmpresaDestino</td>
                                <td>@pedido.Origen</td>
                                <td>@pedido.Destino</td>
                                <td>
                                    @if (pedido.Estado != "Entregado")
                                    {
                                        <form asp-action="MarcarComoEntregado" method="post" style="display:inline;">
                                            <input type="hidden" name="idPedido" value="@pedido.IdPedido" />
                                            <button type="submit" class="btn btn-success">Marcar como Recibido</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Entregado</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

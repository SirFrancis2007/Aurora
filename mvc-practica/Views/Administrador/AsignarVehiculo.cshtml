@{
    ViewData["Title"] = "Empresa";
    Layout = "_AdminLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/NuevoPedido.css" />
}

<!-- Formulario para agregar un nuevo Pedido -->
<div class="main-content">
    <div class="text-empresa">
        <h2>Agregar Nuevo Pedido</h2>
    </div>

    <div class="container">
        <form method="post" action="">
            <div class="form-group">
                <label for="Vehiculo">Vehiculo:</label>
                <select name="" id=""></select>
            </div>
        </form>
        <button type="submit" class="btn-submit">Despacha Pedido</button>
    </div>
</div>
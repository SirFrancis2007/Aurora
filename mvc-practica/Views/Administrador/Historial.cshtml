@using Aurora.Core
@model IEnumerable<HistorialDTO>
@{
    ViewData["Title"] = "Administrador";
    Layout = "_AdminLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/_sidebar.css" />
    <link rel="stylesheet" href="~/css/_table.css" />
}

<div class="main-content">
    <div class="container">
        <h1>Historial de Pedidos</h1>
        <div class="table-container">
            <table class="Content-table">
                <thead class="table-header">
                    <tr>
                        <th>idPedido</th>
                        <th>Nombre Pedido</th>
                        <th>Volumen</th>
                        <th>Peso</th>
                        <th>Estado Pedido</th>
                        <th>Fecha Despacho</th>
                        <th>Tipo Vehiculo</th>
                        <th>Matricula</th>
                        <th>Conductor</th>
                        <th>Sucursal de Origen</th>
                        <th>Sucursal de Destino</th>
                        <th>Lugar de Origen</th>
                        <th>Lugar de Destino</th>
                        <th>Estado Anterior</th>
                        <th>Estado Nuevo</th>
                        <th>Fecha Modificacion</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var historial in Model)
                    {
                        <tr>
                            <td>@historial.idPedido</td>
                            <td>@historial.NombrePedido</td>
                            <td>@(historial.Volumen + "m3")</td>
                            <td>@(historial.Peso + "kg")</td>
                            <td>@historial.EstadoPedido</td>
                            <td>@historial.FechaDespacho.ToString("dd/MM/yyyy")</td>                                    
                            <td>@historial.TipoVehiculo</td>
                            <td>@historial.Matricula</td>
                            <td>@historial.Conductor</td>
                            <td>@historial.EmpresaOrigen</td>
                            <td>@historial.EmpresaDestino</td>
                            <td>@historial.Origen</td>
                            <td>@historial.Destino</td>
                            <td>@historial.EstadoAnterior</td>
                            <td>@historial.EstadoNuevo</td>
                            <td>@historial.FechaCambio</td>
                        </tr>
                    }
            </table>
        </div>
    </div>
</div>

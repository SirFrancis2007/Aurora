@using Aurora.Core
@model IEnumerable<HistorialDTO>
@{
    ViewData["Title"] = "Administrador";
    Layout = "_AdminLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/_sidebar.css" />
    <link rel="stylesheet" href="~/css/_table.css" />
}

<div class="main-content">
    <div class="container">
        <h1>Historial de Pedidos</h1>
        <div class="table-container">
            <table class="Content-table">
                <thead class="table-header">
                    <tr>
                        <th>idPedido</th>
                        <th>Nombre Pedido</th>
                        <th>Volumen</th>
                        <th>Peso</th>
                        <th>Estado Pedido</th>
                        <th>Fecha Despacho</th>
                        <th>Tipo Vehiculo</th>
                        <th>Matricula</th>
                        <th>Conductor</th>
                        <th>Sucursal de Origen</th>
                        <th>Sucursal de Destino</th>
                        <th>Lugar de Origen</th>
                        <th>Lugar de Destino</th>
                        <th>Estado Anterior</th>
                        <th>Estado Nuevo</th>
                        <th>Fecha Modificacion</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var historial in Model)
                    {
                        <tr>
                            <td data-label="Código">@historial.idPedido</td>
                            <td data-label="Nombre">@historial.NombrePedido</td>
                            <td data-label="Volumen">@(historial.Volumen + "m3")</td>
                            <td data-label="Peso">@(historial.Peso + "kg")</td>
                            <td data-label="Estado">@historial.EstadoPedido</td>
                            <td data-label="FechaDespacho">@historial.FechaDespacho.ToString("dd/MM/yyyy")</td>                                    
                            <td data-label="Tipo">@historial.TipoVehiculo</td>
                            <td data-label="Matricula">@historial.Matricula</td>
                            <td data-label="Conductor">@historial.Conductor</td>
                            <td data-label="Surcursal de Origen">@historial.EmpresaOrigen</td>
                            <td data-label="Sucursal de destino">@historial.EmpresaDestino</td>
                            <td data-label="Origen">@historial.Origen</td>
                            <td data-label="Destino">@historial.Destino</td>
                            <td data-label="Estado anterior">@historial.EstadoAnterior</td>
                            <td data-label="Estado Nuevo">@historial.EstadoNuevo</td>
                            <td data-label="FechaCambio">@historial.FechaCambio</td>
                        </tr>
                    }
            </table>
        </div>
    </div>
</div>
